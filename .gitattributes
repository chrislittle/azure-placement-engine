# Normalise to LF in the repository. Without this, working on Windows rewrites
# every file on checkout and every commit reports a line-ending change.
* text=auto eol=lf

# Windows-native tooling that expects CRLF locally.
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Never touched.
*.png   binary
*.jpg   binary
*.ico   binary
