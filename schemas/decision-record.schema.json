{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DecisionRecord",
  "$defs": {
    "AdjustmentTier": {
      "description": "How much friction a remediation actually carries.\n\n\"Needs a quota increase\" spans an enormous range in practice. For some\nproviders it is a `Microsoft.Quota` PUT \u2014 programmatic, immediate, no human.\nFor others it is a portal flow, and for others a support ticket with\nengineering review and days of lead time. A recommendation that treats those\nas the same thing is misleading about the only question that matters to a\nlaunch date.",
      "enum": [
        "self-service",
        "portal",
        "support-ticket",
        "not-adjustable",
        "unknown"
      ],
      "title": "AdjustmentTier",
      "type": "string"
    },
    "Candidate": {
      "additionalProperties": false,
      "description": "A complete, viable topology \u2014 never a bare region.\n\nRecovery requirements make the unit of answer a region *set*: a workload with\na five-minute-RTO flow has no meaningful single-region answer.",
      "properties": {
        "rank": {
          "title": "Rank",
          "type": "integer"
        },
        "placements": {
          "items": {
            "$ref": "#/$defs/Placement"
          },
          "title": "Placements",
          "type": "array"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/ComponentDecision"
          },
          "title": "Components",
          "type": "array"
        },
        "flows": {
          "items": {
            "$ref": "#/$defs/FlowOutcome"
          },
          "title": "Flows",
          "type": "array"
        },
        "remediations": {
          "description": "Actions needed before this candidate can be deployed. A region requiring a quota increase is still a viable recommendation \u2014 quota and access gaps are annotations, not exclusions, since even a refused request can be escalated. Empty means deployable as it stands.",
          "items": {
            "$ref": "#/$defs/Remediation"
          },
          "title": "Remediations",
          "type": "array"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "subscores": {
          "additionalProperties": {
            "$ref": "#/$defs/Subscore"
          },
          "title": "Subscores",
          "type": "object"
        },
        "risks": {
          "items": {
            "$ref": "#/$defs/Risk"
          },
          "title": "Risks",
          "type": "array"
        },
        "estimated_cost_monthly_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Cost Monthly Usd"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "One-line human-readable rationale.",
          "title": "Summary"
        }
      },
      "required": [
        "rank",
        "placements",
        "components",
        "score",
        "subscores"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "ComponentDecision": {
      "additionalProperties": false,
      "description": "The component-centric view, including the topology the engine *derived*.\n\nTopology is an output. A component inherits the strictest recovery targets\namong the flows it serves, so a reporting store sitting only on a 24-hour\nflow is not made to pay for active-passive.",
      "properties": {
        "component": {
          "title": "Component",
          "type": "string"
        },
        "topology": {
          "description": "Derived topology, e.g. 'zonal', 'active-passive'.",
          "title": "Topology",
          "type": "string"
        },
        "regions": {
          "items": {
            "type": "string"
          },
          "title": "Regions",
          "type": "array"
        },
        "driving_flow": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The flow whose RTO/RPO set this topology.",
          "title": "Driving Flow"
        },
        "derived_rto": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Derived Rto"
        },
        "derived_rpo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Derived Rpo"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "overridden": {
          "default": false,
          "description": "True when the requirements pinned this topology rather than the engine.",
          "title": "Overridden",
          "type": "boolean"
        }
      },
      "required": [
        "component",
        "topology",
        "regions",
        "rationale"
      ],
      "title": "ComponentDecision",
      "type": "object"
    },
    "Elimination": {
      "additionalProperties": false,
      "description": "Why a region never reached scoring.\n\nAn elimination carrying a `remediation` is **provisional**: the region is out\ntoday, but the customer can act to bring it back. Consumers must not present\nthose identically to permanent ones.",
      "properties": {
        "region": {
          "title": "Region",
          "type": "string"
        },
        "stage": {
          "$ref": "#/$defs/EliminationStage"
        },
        "rule": {
          "description": "The rule that fired, e.g. 'residency.jurisdictions'.",
          "title": "Rule",
          "type": "string"
        },
        "component": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Component"
        },
        "flow": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Flow"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "remediation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Remediation"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set when the elimination is liftable by a request."
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "region",
        "stage",
        "rule",
        "reason"
      ],
      "title": "Elimination",
      "type": "object"
    },
    "EliminationStage": {
      "description": "Hard-filter stages, in evaluation order. The first five map to CAF's\n'Select Azure regions' criteria.",
      "enum": [
        "residency",
        "compliance",
        "service-availability",
        "capability-availability",
        "capacity",
        "latency-budget",
        "resiliency",
        "flow-constraint",
        "landing-zone-policy"
      ],
      "title": "EliminationStage",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "A single cited fact. Everything the engine asserts traces back to one.",
      "properties": {
        "source": {
          "description": "Fact source id, e.g. 'arm-locations', 'compute-skus', 'retail-prices', 'postgres-capabilities'.",
          "title": "Source",
          "type": "string"
        },
        "as_of": {
          "description": "When the fact was observed, not when this record was written.",
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Locator within the source \u2014 API path or row key.",
          "title": "Ref"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "confidence": {
          "default": 1.0,
          "description": "1.0 for deterministic facts \u2014 a service is or is not in a region, a SKU is or is not restricted for this subscription. Below 1.0 for inferred signals such as capacity headroom, where no authoritative API exists.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "source",
        "as_of"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FlowOutcome": {
      "additionalProperties": false,
      "description": "How one WAF flow fares under a candidate.\n\nA flow split across regions is not necessarily wrong \u2014 but it must be\nvisible, priced, and attributed to the flow's criticality.",
      "properties": {
        "flow": {
          "title": "Flow",
          "type": "string"
        },
        "criticality": {
          "title": "Criticality",
          "type": "string"
        },
        "regions": {
          "description": "Regions this flow's path spans.",
          "items": {
            "type": "string"
          },
          "title": "Regions",
          "type": "array"
        },
        "split": {
          "description": "True when the path crosses a region boundary.",
          "title": "Split",
          "type": "boolean"
        },
        "meets_rto": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Meets Rto"
        },
        "meets_rpo": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Meets Rpo"
        },
        "added_latency_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Extra round-trip introduced by splitting the path.",
          "title": "Added Latency Ms"
        },
        "egress_cost_monthly_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cross-region data transfer cost implied by the split.",
          "title": "Egress Cost Monthly Usd"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "flow",
        "criticality",
        "regions",
        "split"
      ],
      "title": "FlowOutcome",
      "type": "object"
    },
    "Placement": {
      "additionalProperties": false,
      "description": "The region-centric view: what lands where.",
      "properties": {
        "region": {
          "title": "Region",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/RegionRole"
        },
        "zones": {
          "items": {
            "type": "string"
          },
          "title": "Zones",
          "type": "array"
        },
        "components": {
          "items": {
            "type": "string"
          },
          "title": "Components",
          "type": "array"
        }
      },
      "required": [
        "region",
        "role"
      ],
      "title": "Placement",
      "type": "object"
    },
    "RegionRole": {
      "enum": [
        "primary",
        "secondary",
        "tertiary",
        "witness"
      ],
      "title": "RegionRole",
      "type": "string"
    },
    "Relaxation": {
      "additionalProperties": false,
      "description": "A specific, priced way to unstick an over-constrained problem.\n\nThis is what flow criticality buys. Rather than returning 'infeasible', the\nengine can say which low-criticality flow to split, or which capability to\ndrop, and what that opens up.",
      "properties": {
        "target": {
          "description": "The flow, component, or constraint to relax.",
          "title": "Target",
          "type": "string"
        },
        "kind": {
          "description": "'split-flow' | 'relax-capability' | 'widen-residency' | 'drop-optional-component' | 'raise-quota' | 'relax-latency-budget'",
          "title": "Kind",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "unlocks": {
          "description": "Regions or topologies this enables.",
          "items": {
            "type": "string"
          },
          "title": "Unlocks",
          "type": "array"
        },
        "gives_up": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the relaxation costs.",
          "title": "Gives Up"
        },
        "criticality_of_target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why this is a defensible thing to relax first.",
          "title": "Criticality Of Target"
        }
      },
      "required": [
        "target",
        "kind",
        "detail"
      ],
      "title": "Relaxation",
      "type": "object"
    },
    "Remediation": {
      "additionalProperties": false,
      "description": "A concrete action that would lift an elimination.\n\nDistinct from `Relaxation`, and the difference matters to whoever reads the\nrecord. A **remediation** changes the customer's Azure entitlements and\nleaves the design intact \u2014 request access to the region, raise the quota. A\n**relaxation** changes the requirements themselves \u2014 split a flow, drop a\ncapability. One is a ticket; the other is a design concession.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/RemediationKind"
        },
        "detail": {
          "description": "What specifically is gated.",
          "title": "Detail",
          "type": "string"
        },
        "tier": {
          "$ref": "#/$defs/AdjustmentTier",
          "default": "unknown",
          "description": "How much friction the action carries \u2014 self-service through support ticket."
        },
        "process": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How to request it.",
          "title": "Process"
        },
        "reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Documentation URL for the process.",
          "title": "Reference"
        },
        "lead_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Rough turnaround, when known. Requests are reviewed by engineering, so this is planning information, not a guarantee.",
          "title": "Lead Time"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Routing caveats, e.g. zonal asks that must go elsewhere.",
          "title": "Note"
        }
      },
      "required": [
        "kind",
        "detail"
      ],
      "title": "Remediation",
      "type": "object"
    },
    "RemediationKind": {
      "description": "Whether an elimination can be lifted, and by what action.\n\nCentral to the engine being useful rather than merely correct. Azure region\nand zonal access are **not open by default** \u2014 a number of regions are\naccess-restricted, and zonal or service access in others is gated behind a\nquota request. Those are ordinary, successful support requests, not dead\nends. Reporting \"unavailable\" where the honest answer is \"available on\nrequest, allow lead time\" would send customers to a worse region for no\nreason.",
      "enum": [
        "none",
        "region-access-request",
        "zonal-access-request",
        "quota-increase",
        "wait-temporary-block",
        "unknown"
      ],
      "title": "RemediationKind",
      "type": "string"
    },
    "Risk": {
      "additionalProperties": false,
      "description": "Something true about a surviving recommendation that the reader must know.\n\nDistinct from an elimination: the candidate survived, but not cleanly. A thin\ncapacity signal, a preview-stage capability, or a capability the snapshot\ncould not confirm belongs here \u2014 unknown is never silently treated as\navailable.",
      "properties": {
        "severity": {
          "description": "'low' | 'medium' | 'high'",
          "title": "Severity",
          "type": "string"
        },
        "category": {
          "description": "e.g. 'capacity', 'preview-capability', 'unconfirmed-capability', 'stale-data', 'region-maturity', 'flow-split'.",
          "title": "Category",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "mitigation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mitigation"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "severity",
        "category",
        "detail"
      ],
      "title": "Risk",
      "type": "object"
    },
    "SnapshotRef": {
      "additionalProperties": false,
      "description": "Pins the world data a decision was made against. Without it, a decision is\nunreproducible and a re-run six months later is indistinguishable from a bug.",
      "properties": {
        "version": {
          "description": "Snapshot version id, e.g. '2026-08-01'.",
          "title": "Version",
          "type": "string"
        },
        "digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Content hash of the snapshot as loaded.",
          "title": "Digest"
        },
        "sources": {
          "additionalProperties": {
            "format": "date-time",
            "type": "string"
          },
          "description": "Per-source as-of dates, so partial staleness is visible.",
          "title": "Sources",
          "type": "object"
        }
      },
      "required": [
        "version"
      ],
      "title": "SnapshotRef",
      "type": "object"
    },
    "Subscore": {
      "additionalProperties": false,
      "description": "One scored dimension for one candidate. Weights come from the caller's\n`priorities` block \u2014 the reader can disagree with the weighting instead of\ndisagreeing with the tool.",
      "properties": {
        "value": {
          "description": "Normalised 0-1, higher is better.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Value",
          "type": "number"
        },
        "weight": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Weight",
          "type": "number"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "value",
        "weight",
        "rationale"
      ],
      "title": "Subscore",
      "type": "object"
    },
    "TenantRef": {
      "additionalProperties": false,
      "description": "Pins the customer-specific context used, without embedding identifiers by default.",
      "properties": {
        "mode": {
          "description": "'offline' | 'live' | 'none'",
          "title": "Mode",
          "type": "string"
        },
        "collected_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Collected At"
        },
        "subscription_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subscription Id"
        },
        "digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        }
      },
      "required": [
        "mode"
      ],
      "title": "TenantRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "default": "placement/v0",
      "title": "Apiversion",
      "type": "string"
    },
    "kind": {
      "default": "DecisionRecord",
      "title": "Kind",
      "type": "string"
    },
    "workload": {
      "title": "Workload",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "engine_version": {
      "title": "Engine Version",
      "type": "string"
    },
    "snapshot": {
      "$ref": "#/$defs/SnapshotRef"
    },
    "tenant": {
      "$ref": "#/$defs/TenantRef"
    },
    "requirements_digest": {
      "description": "Hash of the requirements that produced this record.",
      "title": "Requirements Digest",
      "type": "string"
    },
    "recommended": {
      "anyOf": [
        {
          "$ref": "#/$defs/Candidate"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "None when every region was eliminated \u2014 a legitimate and important answer, and the case where `relaxations` earns its keep."
    },
    "alternatives": {
      "items": {
        "$ref": "#/$defs/Candidate"
      },
      "title": "Alternatives",
      "type": "array"
    },
    "eliminations": {
      "items": {
        "$ref": "#/$defs/Elimination"
      },
      "title": "Eliminations",
      "type": "array"
    },
    "relaxations": {
      "items": {
        "$ref": "#/$defs/Relaxation"
      },
      "title": "Relaxations",
      "type": "array"
    },
    "warnings": {
      "description": "Anything the engine could not honour, e.g. a declared horizon it did not model. Never silently ignore a stated requirement.",
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "workload",
    "generated_at",
    "engine_version",
    "snapshot",
    "tenant",
    "requirements_digest"
  ],
  "type": "object"
}
